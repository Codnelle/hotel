---
import type { Img } from '../content/site';
import { findImage, tint } from '../lib/images';

interface Props {
  img: Img;
  class?: string;
  sizes?: string;
  eager?: boolean;
  reveal?: boolean;
  width?: number;
  height?: number;
}
const { img, class: cls = '', sizes = '100vw', eager = false, reveal = true, width = 1600, height = 1200 } = Astro.props;
const src = findImage(img.key);
---
<figure class:list={['photo', cls]} data-reveal={reveal ? 'image' : undefined}>
  {src ? (
    <img
      class="absolute inset-x-0 -top-[7%] !h-[114%] w-full object-cover"
      data-parallax
      src={src}
      alt={img.alt}
      width={width}
      height={height}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  ) : (
    <div class={`ph ph-${tint(img.key)}`} role="img" aria-label={img.alt}>
      <span class="ph-label" aria-hidden="true">{img.label}</span>
    </div>
  )}
</figure>
