---
import { home } from '../../content/site';
import { findImage, publicFileExists } from '../../lib/images';
import Headline from '../Headline.astro';
import Clouds from '../Clouds.astro';

const { hero } = home;
const poster = findImage(hero.poster.key);
// Smaller hero files for phones, when present (hero-poster-800.webp, hero-poster-1400.webp).
const srcset = poster
  ? [800, 1400]
      .map((w) => [findImage(`${hero.poster.key}-${w}`), w] as const)
      .filter(([u]) => u)
      .map(([u, w]) => `${u} ${w}w`)
      .concat(`${poster} 2400w`)
      .join(', ')
  : undefined;
const mp4 = publicFileExists(hero.video.mp4) ? hero.video.mp4 : undefined;
const webm = publicFileExists(hero.video.webm) ? hero.video.webm : undefined;
---
<section class="hero relative h-[100svh] min-h-[34rem] overflow-hidden" aria-labelledby="hero-title" data-cloud-host>
  <div class="hero-poster absolute inset-0" role="img" aria-label={hero.poster.alt}>
    {poster && <img src={poster} srcset={srcset} sizes="100vw" alt="" width="2400" height="1357" class="hero-img absolute inset-0 h-full w-full object-cover" fetchpriority="high" decoding="async" />}
  </div>
  {(mp4 || webm) && (
    <video
      class="hero-video absolute inset-0 h-full w-full object-cover"
      muted
      loop
      playsinline
      preload="none"
      poster={poster ?? undefined}
      aria-hidden="true"
      data-hero-video
      data-mp4={mp4}
      data-webm={webm}
    />
  )}
  {poster && <div class="hero-veil absolute inset-0" aria-hidden="true"></div>}
  <div class="absolute inset-x-0 bottom-0 h-[22%] bg-gradient-to-b from-transparent to-mist" aria-hidden="true"></div>

  <Clouds variant="hero" eager class="top-[30%] h-[75%]" />

  <div class:list={['wrap relative z-[3] flex h-full flex-col', poster ? 'justify-start pt-[calc(var(--header-h)+9svh)] md:pt-[calc(var(--header-h)+7svh)]' : 'justify-end pb-[18svh] md:pb-[16svh]']}>
    <div class="hero-copy md:pl-[8vw]">
      <p class="label mb-6" data-reveal="fade">{hero.label}</p>
      <Headline lines={hero.headline} as="h1" id="hero-title" class="display-xl max-w-[16ch]" />
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 z-[3] hidden -translate-x-1/2 flex-col items-center gap-3 md:flex" aria-hidden="true" data-reveal="fade">
    <span class="scroll-cue block h-12 w-px bg-ink/40"></span>
  </div>
</section>

<style>
  .hero-poster {
    background:
      radial-gradient(120% 70% at 70% 18%, rgba(255, 255, 255, 0.75), transparent 60%),
      linear-gradient(180deg, #f4f2ec 0%, #e4e8e4 30%, #c3d0cd 58%, #9fb4b1 80%, #8aa3a1 100%);
  }
  .hero-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-size: 160px;
    opacity: 0.18;
    mix-blend-mode: multiply;
  }
  /* Slow drift on the still photo, so the hero breathes even without video */
  .hero-img {
    transform-origin: 60% 55%;
    animation: hero-drift 28s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  @keyframes hero-drift {
    from { transform: scale(1.12) translate3d(1.5%, 1%, 0); }
    to { transform: scale(1.02) translate3d(0, 0, 0); }
  }
  /* Mist wash at the top so the headline sits on pale sky */
  .hero-veil {
    background: linear-gradient(180deg, rgba(239, 238, 233, 0.82) 0%, rgba(239, 238, 233, 0.55) 34%, rgba(239, 238, 233, 0) 62%);
  }
  .hero-video {
    opacity: 0;
    transition: opacity 2s var(--ease-mist);
  }
  .hero-video:global(.is-playing) {
    opacity: 1;
  }
  .scroll-cue {
    transform-origin: top;
    animation: cue 3.2s var(--ease-mist) infinite;
  }
  @keyframes cue {
    0% { transform: scaleY(0); opacity: 0; }
    35% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue,
    .hero-img { animation: none; }
  }
</style>
