---
import { whatsappHref, ui } from '../content/site';
interface Props { class?: string; label?: string; message?: string }
const { class: cls = '', label = ui.whatsapp, message } = Astro.props;
---
<a class:list={['btn btn-quiet', cls]} href={whatsappHref(message)} target="_blank" rel="noopener">
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 20.5l1.3-4.2A8.5 8.5 0 1 1 8 19.4z"/><path d="M9 8.5c0 3.5 2.8 6.5 6.5 6.5l1-1.6-2-1-1 .9c-1.2-.5-2.3-1.6-2.8-2.8l.9-1-1-2z"/></svg>
  <span>{label}</span>
  <span class="sr-only">(opens WhatsApp)</span>
</a>
