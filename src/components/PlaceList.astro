---
/**
 * Places around Kalimpong as large serif rows. Each opens to a short note.
 * On desktop a photograph of the place drifts after the cursor as you hover.
 */
import { places } from '../content/site';
import { findImage, tint } from '../lib/images';
import Photo from './Photo.astro';
---
<div class="relative" data-places>
  <ul class="border-t border-teesta/50">
    {places.map((p, i) => (
      <li class="border-b border-teesta/50" data-place data-img={findImage(p.image.key) ?? ''}>
        <h3>
          <button
            type="button"
            class="group grid w-full grid-cols-[2.5rem_1fr_auto] items-baseline gap-x-4 py-7 text-left md:grid-cols-[5rem_1fr_auto] md:py-10"
            aria-expanded="false"
            aria-controls={`place-${p.id}`}
            data-place-toggle
          >
            <span class="label tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span class="place-name font-display text-[2.3rem] leading-none font-light md:text-[clamp(3rem,6vw,6rem)]">{p.name}</span>
            <span class="place-plus" aria-hidden="true"></span>
          </button>
        </h3>
        <div id={`place-${p.id}`} class="place-panel" role="region" aria-label={p.name} hidden data-place-panel>
          <div class="grid gap-8 pb-10 md:grid-cols-[5rem_1fr_1fr] md:gap-x-4 md:pb-14">
            <span class="hidden md:block"></span>
            <div>
              <p class="label mb-4">{p.meta}</p>
              <p class="lede max-w-[30ch]">{p.note}</p>
            </div>
            <div class="md:hidden">
              <Photo img={p.image} class="aspect-[4/5] w-3/4" sizes="75vw" width={900} height={1125} reveal={false} />
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>

  <!-- cursor-follow preview (desktop, decorative) -->
  <div class="place-preview" aria-hidden="true" data-place-preview>
    {places.map((p) => {
      const src = findImage(p.image.key);
      return src ? (
        <img src={src} alt="" loading="lazy" decoding="async" data-preview={p.id} />
      ) : (
        <div class={`ph ph-${tint(p.image.key)}`} data-preview={p.id}></div>
      );
    })}
  </div>
</div>

<style>
  .place-name {
    transition: transform 1s var(--ease-mist), color 0.6s var(--ease-mist);
  }
  button:hover .place-name,
  button[aria-expanded='true'] .place-name {
    font-style: italic;
    transform: translateX(0.6rem);
  }
  .place-plus {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
    align-self: center;
  }
  .place-plus::before,
  .place-plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--ink);
    transition: transform 0.7s var(--ease-mist);
  }
  .place-plus::after {
    transform: rotate(90deg);
  }
  button[aria-expanded='true'] .place-plus::after {
    transform: rotate(0deg);
  }
  .place-preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 30;
    width: 20vw;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-50%, -50%, 0) scale(0.92);
    transition: opacity 0.7s var(--ease-mist), scale 0.7s var(--ease-mist);
    overflow: hidden;
    display: none;
  }
  @media (hover: hover) and (min-width: 48rem) {
    .place-preview {
      display: block;
    }
  }
  .place-preview:global(.is-on) {
    opacity: 1;
  }
  .place-preview > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s var(--ease-mist);
  }
  .place-preview > :global(.is-on) {
    opacity: 1;
  }
</style>
